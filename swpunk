#!/bin/sh

_print_help ()
{
    echo "Usage: swpunk [OPTIONS] COMMAND [COMMAND_ARGS]"
    echo ""
    echo "Commands:"
    echo "  get FOO [BAR...]          get items from the registry"
    echo "  search FOO [BAR...]       search for matching text"
    echo "  where FOO [BAR...]        print the file where the entry is present"
    echo ""
    echo "Common:"
    echo "  -r REPO                   set repo folder to REPO, read from stdin by default"
    echo "  -d                        enable dry-run mode, only print commands"
    echo ""
    echo "Output:"
    echo "  -h                        enable verbose human-readable mode"
    echo "  -f FIELDS                 print out the following comma-separated fields;"
    echo "                            the result is separated with spaces"
    echo ""
    echo "FIELDS may contain ..."
    echo ""
}

_get_grep_color_opts ()
{
    # Add "--color=auto" to arguments if grep supports it
    if [ "$(grep --help | grep color | wc -l)" -gt 0 ]; then
        GREP_COLOR_OPTS="--color=auto"
    else
        GREP_COLOR_OPTS=""
    fi
}

_init_dry_run ()
{
    # If dry run mode is enabled, prepend each command with "echo"
    if [ -z "$DRY_RUN" ]; then
        DRY_RUN_CMD=""
    else
        DRY_RUN_CMD="echo"
    fi
}

_process_fields ()
{
    # Process the fields command-line argument
    # This function takes in the value of the -f argument and sets the env variables
    if [ -z "$1" ]; then
        return 0
    fi

    PRINT_NAME=""
    rhs="$1"
    IFS=','
    # super janky split str
    while read -r tok rhs <<EOF
$rhs
EOF
    do
        case "$tok" in
            name) PRINT_NAME=1;;
            *)    echo "-f: field not found: ${tok}." >&2
                  _print_help
                  exit 1;;
        esac

        if [ -z "$rhs" ]; then
            break
        fi
    done
}

fmt ()
{
    # Format the function input
    #
    # Env variables/arguments:
    # TODO fill in the docstring

    AWK_CODE="split(\$0,entry,\" \"); "
    AWK_PRINT_STMT=""
    AWK_FIRST_ARG_DONE=""

    if [ -z "$FIELDS" ]; then
        cat -
        return 0
    fi

    rhs="$FIELDS"
    IFS=','
    # super janky split str
    while read -r tok rhs <<EOF
$rhs
EOF
    do
        if [ "$AWK_FIRST_ARG_DONE" = "1" ]; then
            AWK_PRINT_STMT="${AWK_PRINT_STMT},"
        fi

        # TODO add Desc: and other fields handling (somehow), add approx size handling
        case "$tok" in
            name) AWK_PRINT_STMT="${AWK_PRINT_STMT}entry[2]"
                  AWK_CODE="${AWK_CODE}sub(\"^Name:\", \"\", entry[2]); ";;  # remove Name: prefix
            size) AWK_PRINT_STMT="${AWK_PRINT_STMT}entry[3]";;
            keys) AWK_PRINT_STMT="${AWK_PRINT_STMT}entry[4]";;
            link) AWK_PRINT_STMT="${AWK_PRINT_STMT}entry[5]";;
            *)    echo "-f: field not found: ${tok}." >&2
                  _print_help
                  exit 1;;
        esac

        AWK_FIRST_ARG_DONE=1

        if [ -z "$rhs" ]; then
            break
        fi
    done

    cat - | grep -e "Name:" | awk "{${AWK_CODE}print(${AWK_PRINT_STMT})}"
}

get_item ()
{
    # Get the unique item in the repo by its name and print its entry
    #
    # Env variables/arguments:
    # $SWPUNK_REPO : repo folder
    # $HUMAN_READABLE : enable human-readable (verbose) mode
    # $DRY_RUN_CMD : either "echo" or ""
    # $ONLY_PRINT_FILE : print where is the item located
    # $1 - ... : get item or multiple items
    #
    # SIMPLE ALTERNATIVE: grep -rwe "Name:abc" -e "Desc:abc" -e "Warn:abc" -e "Repo:abc" -- path_to_repo

    if [ $# -eq 0 ]; then
        echo "No item to get. Please specify one or more arguments" >&2
        return 1
    fi

    # Only used if SWPUNK_REPO is set
    # TODO check if we should handle the case where grep doesn't have -r flag
    if [ -z "$HUMAN_READABLE" ]; then
        GREP_FLAGS="-hr"  # Disable line output in default mode
    else
        GREP_FLAGS="-r"   # Enable in human-readable mode
    fi

    if [ "$ONLY_PRINT_FILE" = "1" ]; then
        if [ -z "$SWPUNK_REPO" ]; then
            echo "File search requires REPO to be set" >&2
            _print_help
            exit 1
        fi
        GREP_FLAGS="${GREP_FLAGS}Fl"
    fi

    # Construct the string to pass into grep
    N=$#
    while [ "$N" -gt 0 ]; do
        # replace [foo bar baz] with [foo bar baz -e "Name:foo" -e ... ]
        set -- "$@" -e "Name:$1" -e "Desc:$1" -e "Warn:$1" -e "Repo:$1"
        shift         # drop [foo]
        N=$((N - 1))  # do at least N times, so that [foo bar baz] are replaced
    done

    if [ -z "$SWPUNK_REPO" ]; then  # read from stdin
        $DRY_RUN_CMD cat - | grep "-w" "$@" | fmt
    else
        $DRY_RUN_CMD grep "${GREP_FLAGS}w" "$@" -- "$SWPUNK_REPO" | fmt
    fi
}

requires ()
{
    # Find requirements of an item
    #
    # Env variables/arguments:
    # $SWPUNK_REPO : repo folder
    # $HUMAN_READABLE : enable human-readable (verbose) mode
    # $2 : optional item name
    return 0
}

search_item ()
{
    # Search for all string matches (case-insensitive)
    #
    # Env variables/arguments:
    # $SWPUNK_REPO : repo folder
    # $HUMAN_READABLE : enable human-readable (verbose) mode
    # $DRY_RUN_CMD : either "echo" or ""
    # $1 - ... : item name (or multiple items)
    #
    # SIMPLE ALTERNATIVE: grep -rie "abc" -e "xyz" -- path_to_repo

    if [ $# -eq 0 ]; then
        echo "No item to search. Please specify one or more arguments" >&2
        return 1
    fi

    # Only used if SWPUNK_REPO is set
    # TODO check if we should handle the case where grep doesn't have -r flag
    if [ -z "$HUMAN_READABLE" ]; then
        GREP_FLAGS="-hr"  # Disable line output in default mode
    else
        GREP_FLAGS="-r"   # Enable in human-readable mode
    fi

    # Construct the string to pass into grep
    N=$#
    while [ "$N" -gt 0 ]; do
        # replace [foo bar baz] with [foo bar baz -e foo], we append -e ... to the end of $@
        set -- "$@" -e "$1"
        shift         # drop [foo]
        N=$((N - 1))  # do at least N times, so that [foo bar baz] are replaced
    done

    if [ -z "$SWPUNK_REPO" ]; then  # read from stdin
        $DRY_RUN_CMD cat - | grep $GREP_COLOR_OPTS -i "$@"
    else
        $DRY_RUN_CMD grep "$GREP_FLAGS" $GREP_COLOR_OPTS -i "$@" -- "$SWPUNK_REPO"
    fi
}




# ============================================
# ==============     SWPUNK     ==============
#
#       Welcome to the switchpunk shell!
# ============================================


# TODO remove this
if [ "$#" -lt 2 ]; then
    _print_help
    exit 1
fi

SWPUNK_REPO=""
HUMAN_READABLE=""
DRY_RUN=""
FIELDS=""

# Parse optional args:
while getopts r:hdf: opt; do
    case "$opt" in
        r) SWPUNK_REPO="$OPTARG";;
        h) HUMAN_READABLE="1";;
        d) DRY_RUN="1";;
        f) FIELDS="$OPTARG";;
        *) _print_help ;;
    esac
done
shift $((OPTIND-1))  # discard the parsed arguments


# Parse RHS args:
if [ "$#" -lt 1 ]; then
    _print_help
    exit 1
fi
COMMAND="$1"
shift 1  # discard the command argument

# Pre-compute some params and init variables
_get_grep_color_opts
_init_dry_run
#_process_fields "$FIELDS"
ONLY_PRINT_FILE=""

# Execute the command
case "$COMMAND" in
    get)    get_item "$@" ;;
    search) search_item "$@" ;;
    where)  ONLY_PRINT_FILE=1
            get_item "$@";;
    *)      echo "Command not found: $COMMAND." >&2
            _print_help
            exit 1 ;;
esac
